# CampusVoice configuration. Copy to .env.local for local development.
# The app is a single Next.js project: the UI and the API live together.

# API base URL used by the browser. Keep this relative so requests stay
# same-origin and HttpOnly cookies work without CORS.
NEXT_PUBLIC_API_URL=/api/v1

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/campusvoice
MONGODB_DB_NAME=campusvoice

# Authentication secrets (use 32+ random characters in production)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Secret used to hash anonymous ballots (never exposed to clients)
VOTE_HASH_SECRET=replace_with_a_long_random_ballot_secret

# Seed demo data when the database is empty (set false in production)
SEED_DEMO_DATA=true

# Optional. Cookies are Secure automatically when NODE_ENV=production.
# Set to false only when testing a production build locally over plain HTTP.
# COOKIE_SECURE=false

# First super admin (used only when the database is empty)
ADMIN_USERNAME=super_admin
ADMIN_EMAIL=admin@campusvoice.local
ADMIN_PASSWORD=SuperAdmin123!
