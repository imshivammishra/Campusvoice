# CampusVoice Frontend — environment configuration
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (do NOT commit real values).

# Base URL of the CampusVoice backend API, INCLUDING the /api/v1 suffix.
#   Local:      http://localhost:3001/api/v1
#   Production: https://your-backend-host.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
