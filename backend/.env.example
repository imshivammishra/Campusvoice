# CampusVoice Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

PORT=3001
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/campusvoice?retryWrites=true&w=majority
MONGODB_DB_NAME=campusvoice

# JWT Secrets (generate strong random values)
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Redis
REDIS_URI=redis://localhost:6379

# SMTP Email (for notifications and password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@campusvoice.local

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Security
ADMIN_SECRET=your_admin_secret
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Super Admin bootstrap (deployment-time only)
ADMIN_USERNAME=super_admin
ADMIN_EMAIL=admin@campusvoice.local
ADMIN_PASSWORD=SuperAdmin123!
